{
  "buildCommand": "cd frontend && yarn install --frozen-lockfile && CI=false yarn build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo 'no root install required'",
  "framework": null,
  "functions": {
    "api/[...path].py": {
      "runtime": "@vercel/python@4.3.1",
      "includeFiles": "backend/server.py",
      "excludeFiles": "{frontend/**,**/node_modules/**,.pnpm-store/**,.yarn/**,tests/**,test_reports/**,memory/**,.emergent/**,.ruff_cache/**,.git/**,**/__pycache__/**,**/*.pyc,**/.env,**/.env.*,*.zip,*.md,yarn.lock,backend/requirements.txt}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
